# ── Base de datos PostgreSQL ──────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=pos_db
DB_USER=pos_user
DB_PASSWORD=change_me_secure_password

# ── pgAdmin ────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password

# ── Autenticación JWT ─────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# ── Correo SMTP ───────────────────────────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=pos@mitienda.com
MAIL_FROM_NAME=Sistema POS

# ── Negocio (se refleja en tickets y frontend) ────────────────
BUSINESS_NAME=Mi Tienda

# ── WhatsApp API ──────────────────────────────────────────────
WHATSAPP_API_KEY=

# ── URLs del sistema ──────────────────────────────────────────
APP_URL=http://localhost:8080
FRONTEND_PANEL_URL=http://localhost:3001
FRONTEND_CAJA_URL=http://localhost:3000
