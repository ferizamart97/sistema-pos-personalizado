# App Configuration
APP_ENV=production
APP_PORT=8080
APP_URL=http://localhost:8080

# PostgreSQL Database Configuration
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pos_db
DB_USERNAME=pos_admin
DB_PASSWORD=your_db_secure_password_here

# JWT Authentication
JWT_SECRET=generate_a_secure_jwt_secret_key_here
JWT_EXPIRATION=86400

# SMTP / Email Configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=pos@mitienda.com
MAIL_FROM_NAME="Sistema POS"

# WhatsApp Business / Twilio API
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
